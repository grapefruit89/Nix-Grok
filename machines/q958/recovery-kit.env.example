# Kopieren nach recovery-kit.env und anpassen — NICHT committen wenn Gerätenamen abweichen.
# cp machines/q958/recovery-kit.env.example machines/q958/recovery-kit.env

RECOVERY_YES=1
RECOVERY_BUILD_ISO=1
RECOVERY_FLASH_ISO=1
RECOVERY_ISO_DEV=/dev/sdb
# Optional zweiter Stick für profile.local.nix Backup:
# RECOVERY_DATA_DEV=/dev/sdc
